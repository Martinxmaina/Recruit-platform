# Required for Supabase auth and API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (for redirects)
NEXT_PUBLIC_APP_URL=

# Optional: Copilot / LLM
OPENAI_API_KEY=

# Optional: Google Calendar (add the SAME redirect URI to Google Console → Credentials → Authorized redirect URIs)
# Local:  http://localhost:3000/api/google/callback
# Prod:   https://YOUR_DOMAIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: Invite by email (Resend)
RESEND_API_KEY=
INVITE_FROM_EMAIL=
